  {
   "id": "tex-041",
   "type": "text",
   "x": 54,
   "y": 941.5,
   "width": 1666.56,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
