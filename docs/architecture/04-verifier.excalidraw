  {
   "id": "tex-036",
   "type": "text",
   "x": 54,
   "y": 937.5,
   "width": 1657.6,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
