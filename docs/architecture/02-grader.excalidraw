  {
   "id": "tex-038",
   "type": "text",
   "x": 54,
   "y": 887.5,
   "width": 1684.48,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
